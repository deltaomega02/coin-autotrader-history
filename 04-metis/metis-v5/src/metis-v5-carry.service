[Unit]
Description=METIS V5 funding carry bot (delta-neutral, 1x no-borrow)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=YOUR_SERVICE_USER
WorkingDirectory=YOUR_HOME_DIR/metis-v4
ExecStart=YOUR_HOME_DIR/metis-v4/run_carry.sh
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
