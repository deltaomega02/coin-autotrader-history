[Unit]
Description=METIS V5 daily asset report (Gemini Flash → Telegram)

[Service]
Type=oneshot
User=YOUR_SERVICE_USER
WorkingDirectory=YOUR_HOME_DIR/metis-v4
ExecStart=/bin/bash -c 'cd YOUR_HOME_DIR/metis-v4 && set -a && source v4.env && set +a && YOUR_HOME_DIR/metis-f2/venv/bin/python daily_report.py'
